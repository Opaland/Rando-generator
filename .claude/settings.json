{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/porte-avant-commit.sh\"",
            "timeout": 180,
            "statusMessage": "Porte avant commit : lint, typecheck, tests…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/etat-deploiement.sh\"",
            "timeout": 30,
            "statusMessage": "État du déploiement de main…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run coverage)",
      "Bash(npm run build)",
      "Bash(npm run monkey)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  }
}
