{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 3,
  "timeoutMS": 20000,
  "mutate": [
    "src/core/**/*.ts",
    "!src/core/types.ts"
  ]
}
